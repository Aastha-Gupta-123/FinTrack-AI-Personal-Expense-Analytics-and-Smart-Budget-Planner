# FinTrack AI – Backend Environment Variables
# Copy to .env and fill in your values

# ── Application ───────────────────────────────────────────────────────────────
FLASK_APP=app.py
FLASK_ENV=development

# ── Security — generate strong secrets for production! ────────────────────────
# Use: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-strong-random-secret
JWT_SECRET_KEY=replace-with-a-strong-random-secret

# ── Database ──────────────────────────────────────────────────────────────────
# Create a dedicated local database user and replace the password placeholder with
# the real MySQL credential for the app.
SQLALCHEMY_DATABASE_URI=mysql+pymysql://fintrack_user:REPLACE_WITH_STRONG_PASSWORD@localhost:3306/fintrack_db

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# ── Python path (needed when running with Gunicorn) ───────────────────────────
PYTHONPATH=.
