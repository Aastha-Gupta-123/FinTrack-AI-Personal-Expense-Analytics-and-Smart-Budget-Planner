# ============================================================
# FinTrack AI – .gitignore
# ============================================================

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.coverage
htmlcov/

# ── Virtual Environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Environment Variables (never commit secrets!) ─────────────────────────────
.env
.env.local
.env.production
.env.development
*.env

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# ── Database files ────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
backend/instance/

# ── Uploaded files ────────────────────────────────────────────────────────────
backend/uploads/*
!backend/uploads/.gitkeep

# ── ML model files (large binaries — use Git LFS or exclude) ─────────────────
backend/machine_learning/models/*.joblib
backend/machine_learning/models/*.pkl
!backend/machine_learning/models/.gitkeep

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
backend/logs/*.log
!backend/logs/.gitkeep

# ── OS / IDE ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ── Coverage reports ─────────────────────────────────────────────────────────
.nyc_output/
coverage/
